# =============================================================================
# Home "Access our media and sermons" section (lib/media.ts)
# Copy the values you need into .env.local
# =============================================================================

# --- Spotify (latest sermon episode) -----------------------------------------
# Required for the Spotify card to auto-update with the latest episode.
# Create a free app at https://developer.spotify.com/dashboard, then copy its
# Client ID and Client secret here. Until both are set, the Spotify card falls
# back to its static content (nothing else breaks).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: override the Spotify show whose latest episode is shown.
# Defaults to the church show id already in code.
# SPOTIFY_SHOW_ID=4KLNlwoOOutIpPgcqfkhDt

# --- YouTube (latest movie + latest live service) ----------------------------
# These work with no credentials (public RSS). We read dedicated playlists so
# each card shows the right content: the latest full movie and the latest live
# service (not the latest skit/clip). Override only to point at different
# playlists.
# YOUTUBE_MOVIES_PLAYLIST_ID=PL7hfDjeiqsWtxih6hjW9LmIKtJYymjHO4  # "THE WINLOS MOVIES"
# YOUTUBE_LIVE_PLAYLIST_ID=PLe1VRppQoYh4Rqdo11qlnkmSsjg3fxMrQ    # @AnwinliOjeikere "LIVE"

# =============================================================================
# Home page hero + events section (lib/contentful.ts)
# =============================================================================

# Required for the hero headline/subtext/background and the events list to be
# editable from Contentful. Until both are set, both sections fall back to
# their static content (nothing else breaks).
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=

# Optional: only needed if you're using a Contentful environment other than
# the default "master".
# CONTENTFUL_ENVIRONMENT=master

# Shared secret for the Contentful publish webhook (app/api/revalidate). Without
# it, published edits take up to 10 minutes to appear; with it they show up
# within seconds. Generate any random string, then add the same value to the
# webhook's "x-contentful-webhook-secret" header in Contentful settings.
CONTENTFUL_REVALIDATE_SECRET=

# --- Baby Dedication Web3Forms Access Key & Recipient Email ------------------
NEXT_PUBLIC_BABY_DEDICATION_WEB3FORMS_KEY=
BABY_DEDICATION_EMAIL=admin@thevotagechurch.org
